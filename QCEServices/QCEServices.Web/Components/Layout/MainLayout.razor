@using QCEServices.Web.Authentication
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Class="ml-2">Quezon City <b>E-Services</b></MudText>
    </MudAppBar>
    <MudMainContent>
        <MudContainer Class="d-flex mt-10" MaxWidth="MaxWidth.ExtraLarge">
            <NavMenu />
            <MudContainer>
                @Body
            </MudContainer>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code
{
    [Inject] private IAccessTokenService AccessTokenService { get; set; }
    [Inject] private IAuthenticationService AuthenticationService { get; set; }
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject] private NavigationManager NavigationManager { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AccessTokenService.IsAuthenticated) return;
        
        try
        {
            var newToken = await AuthenticationService.RefreshUserTokenAsync();
            ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsAuthenticated(newToken);
        }
        catch
        {
            NavigationManager.NavigateTo("/login");
        }
    }
}