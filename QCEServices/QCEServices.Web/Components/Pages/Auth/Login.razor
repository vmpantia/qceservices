@page "/Login"
@using QCEServices.Shared.Models.Dtos.Authentication
@using QCEServices.Web.Contracts.Services.Apis

<h3>Login</h3>

@code {
    
    [Inject] private IAuthenticationApiService AuthenticationApiService { get; set; }
    [Inject] private ISnackbar Snackbar { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthenticationApiService.LoginAsync(new LoginDto { UsernameOrEmail = "admin", Password = "password" });
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

}
